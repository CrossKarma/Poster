<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Poster</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root[data-theme="light"] {
  --bg:#faf7f2; --panel:#ffffff; --sunk:#f4f0e9; --line:#e6dfd4; --line-soft:#f0eae0;
  --text:#2e2a26; --dim:#857c72; --accent:#b4643a; --accent-soft:#fbeee6;
  --good:#4f7a52; --bad:#b04a42;
  --shadow:0 1px 2px rgba(60,50,40,.05),0 6px 18px rgba(60,50,40,.05);
}
:root[data-theme="dark"] {
  --bg:#191715; --panel:#221f1c; --sunk:#1c1a17; --line:#34302b; --line-soft:#2a2723;
  --text:#ece5da; --dim:#9b9186; --accent:#d98b5c; --accent-soft:#2e2620;
  --good:#7da77f; --bad:#d2776d;
  --shadow:0 1px 2px rgba(0,0,0,.2),0 6px 20px rgba(0,0,0,.22);
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);
  font-family:Inter,ui-sans-serif,system-ui,"Segoe UI",Roboto,sans-serif;
  font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased}
button,input,textarea,select{font:inherit;color:inherit}
.wrap{max-width:840px;margin:0 auto;padding:34px 24px 110px}
.top{display:flex;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:22px}
.mark{font-family:Fraunces,Georgia,serif;font-weight:600;font-size:34px;letter-spacing:-.02em;margin:0;line-height:1}
.mark em{font-style:normal;color:var(--accent)}
.sub{color:var(--dim);font-size:14px;padding-bottom:3px}
.top-right{margin-left:auto;display:flex;align-items:center;gap:8px}
.pill{display:inline-flex;align-items:center;gap:7px;background:var(--panel);border:1px solid var(--line);
  border-radius:999px;padding:5px 13px;font-size:12.5px;color:var(--dim);cursor:pointer}
.pill:hover{border-color:var(--dim)}
.dot{width:7px;height:7px;border-radius:50%;background:var(--line);flex:none}
.dot.on{background:var(--good)}
.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:22px;margin-bottom:18px;box-shadow:var(--shadow)}
h2{font-family:Fraunces,Georgia,serif;font-weight:600;font-size:19px;margin:0 0 4px;letter-spacing:-.01em}
.lede{color:var(--dim);font-size:14px;margin:0 0 16px}
label.lab{display:block;font-size:12px;font-weight:500;color:var(--dim);margin-bottom:5px}
input[type=text],textarea{width:100%;background:var(--sunk);border:1px solid var(--line);
  border-radius:9px;padding:9px 12px;font-size:14px;outline:none;margin-bottom:12px}
textarea{min-height:74px;resize:vertical}
input:focus,textarea:focus{border-color:var(--accent)}
.btn{background:var(--accent);color:#fff;border:none;border-radius:9px;padding:10px 18px;
  font-weight:600;font-size:14px;cursor:pointer}
.btn:disabled{opacity:.5;cursor:default}
.btn.ghost{background:var(--panel);color:var(--text);border:1px solid var(--line)}
.btn.ghost:hover{border-color:var(--dim)}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.banner{border:1px solid var(--line);background:var(--accent-soft);border-radius:11px;
  padding:11px 15px;font-size:13.5px;margin-bottom:18px}
.drop{border:2px dashed var(--line);border-radius:14px;padding:44px 20px;text-align:center;
  color:var(--dim);cursor:pointer;transition:border-color .15s}
.drop.hot{border-color:var(--accent);color:var(--text)}
.thumbs{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0 4px}
.thumbs img{width:96px;height:54px;object-fit:cover;border-radius:7px;border:1px solid var(--line)}
.tagline{font-size:12.5px;color:var(--dim);margin:-6px 0 12px}
.stat{font-size:13px;color:var(--dim)}
.ok{color:var(--good)} .err{color:var(--bad)}
.bar{height:7px;background:var(--sunk);border:1px solid var(--line);border-radius:999px;overflow:hidden;margin:10px 0}
.bar>i{display:block;height:100%;width:0%;background:var(--accent);transition:width .2s}
.copyrow{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.hero{padding:64px 20px;text-align:center}
.hero h1{font-family:Fraunces,Georgia,serif;font-weight:600;font-size:44px;letter-spacing:-.02em;margin:0 0 10px}
.hero h1 em{font-style:normal;color:var(--accent)}
.hero p{color:var(--dim);font-size:16px;max-width:520px;margin:0 auto 26px}
.price{font-size:13px;color:var(--dim);margin-top:14px}
.hidden{display:none}
footer{color:var(--dim);font-size:12.5px;text-align:center;margin-top:40px}
</style>
</head>
<body>
<div class="wrap">

  <!-- signed out -->
  <div id="landing" class="hidden">
    <div class="hero">
      <h1>Post<em>er</em></h1>
      <p>Drop in a video. Poster watches it, writes the title, description,
         hashtags and captions for TikTok, Instagram and X, then uploads it to
         your YouTube channel. Minutes of busywork, gone.</p>
      <button class="btn" onclick="location.href='/login'">Sign in with YouTube</button>
      <div class="price">7-day free trial, then $10/month. Cancel anytime.</div>
    </div>
  </div>

  <!-- signed in -->
  <div id="appview" class="hidden">
    <div class="top">
      <h1 class="mark">Post<em>er</em></h1>
      <div class="sub" id="whoami"></div>
      <div class="top-right">
        <span class="pill" onclick="toggleSettings()">Settings</span>
        <span class="pill" onclick="signOut()">Sign out</span>
      </div>
    </div>

    <div id="trialBanner" class="banner hidden"></div>

    <div id="settings" class="card hidden">
      <h2>Your niche</h2>
      <p class="lede">One or two sentences about what your channel makes. Poster uses this to match your voice.</p>
      <textarea id="niche" placeholder="Example: scary stories and horror clips, short unsettling moments, creepy 15 second scares."></textarea>
      <button class="btn ghost" onclick="saveNiche()">Save</button>
      <span id="nicheSaved" class="stat ok"></span>
    </div>

    <div class="card">
      <h2>New video</h2>
      <p class="lede">Pick a video. Poster samples a few frames, works out what it is, and writes everything.</p>
      <div class="drop" id="drop">Drop a video here, or click to choose one</div>
      <input type="file" id="file" accept="video/*" class="hidden">
      <div class="thumbs" id="thumbs"></div>
      <div class="row">
        <button class="btn" id="genBtn" onclick="generate()" disabled>Generate listing</button>
        <span class="stat" id="genStat"></span>
      </div>
    </div>

    <div class="card hidden" id="result">
      <h2>Listing</h2>
      <p class="lede">Edit anything, then upload.</p>
      <label class="lab">Title</label>
      <input type="text" id="fTitle">
      <label class="lab">Description</label>
      <textarea id="fDesc"></textarea>
      <label class="lab">Hashtags (space separated, no #)</label>
      <input type="text" id="fTags">
      <label class="lab">TikTok caption</label>
      <textarea id="fTiktok"></textarea>
      <label class="lab">Instagram caption</label>
      <textarea id="fInsta"></textarea>
      <label class="lab">X post</label>
      <textarea id="fTweet"></textarea>

      <div class="row">
        <button class="btn" id="upBtn" onclick="uploadToYouTube()">Upload to YouTube</button>
        <span class="stat" id="upStat"></span>
      </div>
      <div class="bar hidden" id="upBarWrap"><i id="upBar"></i></div>

      <div id="crosspost" class="hidden">
        <p class="tagline">Uploaded. Now cross-post: the caption goes to your clipboard, the upload page opens, you drop the same file in.</p>
        <div class="copyrow">
          <button class="btn ghost" onclick="crossPost('tiktok')">TikTok</button>
          <button class="btn ghost" onclick="crossPost('instagram')">Instagram</button>
          <button class="btn ghost" onclick="crossPost('x')">Post to X</button>
        </div>
      </div>
    </div>

    <div id="paywall" class="card hidden">
      <h2>Trial ended</h2>
      <p class="lede">Keep Poster for $10/month. Cancel anytime.</p>
      <button class="btn" onclick="subscribe()">Subscribe</button>
    </div>

    <footer>Poster uploads with your own YouTube account. Your videos never sit on our servers.</footer>
  </div>
</div>

<script>
let me = null;
let videoFile = null;
let frames = [];
let lastGen = null;

async function boot() {
  const r = await fetch('/api/me');
  me = await r.json();
  if (!me.signedIn) {
    document.getElementById('landing').classList.remove('hidden');
    return;
  }
  document.getElementById('appview').classList.remove('hidden');
  document.getElementById('whoami').textContent = me.channel ? me.channel : (me.email || '');
  document.getElementById('niche').value = me.niche || '';
  const banner = document.getElementById('trialBanner');
  if (me.status === 'trial') {
    banner.textContent = 'Free trial: ' + me.trialDaysLeft + ' day' + (me.trialDaysLeft === 1 ? '' : 's') + ' left.';
    banner.classList.remove('hidden');
  } else if (me.status === 'expired') {
    document.getElementById('paywall').classList.remove('hidden');
    document.getElementById('genBtn').disabled = true;
  }
  if (!me.niche) document.getElementById('settings').classList.remove('hidden');
}

function toggleSettings(){ document.getElementById('settings').classList.toggle('hidden'); }

async function saveNiche() {
  const niche = document.getElementById('niche').value;
  await fetch('/api/niche', {method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({niche})});
  document.getElementById('nicheSaved').textContent = 'Saved';
  setTimeout(()=>document.getElementById('nicheSaved').textContent='', 1500);
}

async function signOut(){ await fetch('/logout',{method:'POST'}); location.reload(); }

async function subscribe() {
  const r = await fetch('/api/checkout', {method:'POST'});
  const d = await r.json();
  if (d.ok && d.url) location.href = d.url;
  else alert('Billing is not switched on yet. Email us and we will sort you out.');
}

// ----- picking a video and sampling frames -----
const drop = document.getElementById('drop');
const fileInput = document.getElementById('file');
drop.onclick = () => fileInput.click();
drop.ondragover = e => { e.preventDefault(); drop.classList.add('hot'); };
drop.ondragleave = () => drop.classList.remove('hot');
drop.ondrop = e => {
  e.preventDefault(); drop.classList.remove('hot');
  if (e.dataTransfer.files[0]) pickFile(e.dataTransfer.files[0]);
};
fileInput.onchange = () => { if (fileInput.files[0]) pickFile(fileInput.files[0]); };

async function pickFile(f) {
  videoFile = f;
  frames = [];
  lastGen = null;
  document.getElementById('result').classList.add('hidden');
  document.getElementById('crosspost').classList.add('hidden');
  document.getElementById('thumbs').innerHTML = '';
  drop.textContent = f.name;
  document.getElementById('genStat').textContent = 'Reading frames...';
  try {
    frames = await sampleFrames(f, 6);
  } catch (e) {
    frames = [];
  }
  const box = document.getElementById('thumbs');
  frames.forEach(d => { const img = new Image(); img.src = d; box.appendChild(img); });
  const ok = frames.length > 0 && me.status !== 'expired';
  document.getElementById('genBtn').disabled = !ok;
  document.getElementById('genStat').textContent = frames.length
    ? frames.length + ' frames sampled'
    : 'Could not read this video in the browser. Try an mp4.';
}

function sampleFrames(file, count) {
  return new Promise((resolve, reject) => {
    const url = URL.createObjectURL(file);
    const v = document.createElement('video');
    v.muted = true; v.playsInline = true; v.preload = 'auto'; v.src = url;
    const out = [];
    v.onerror = () => { URL.revokeObjectURL(url); reject(new Error('decode')); };
    v.onloadedmetadata = () => {
      const dur = v.duration && isFinite(v.duration) ? v.duration : 0;
      if (!dur) { URL.revokeObjectURL(url); reject(new Error('duration')); return; }
      const times = [];
      for (let i = 0; i < count; i++) times.push(dur * (i + 0.5) / count);
      const canvas = document.createElement('canvas');
      const scale = Math.min(1, 640 / (v.videoWidth || 640));
      canvas.width = Math.round((v.videoWidth || 640) * scale);
      canvas.height = Math.round((v.videoHeight || 360) * scale);
      const ctx = canvas.getContext('2d');
      let i = 0;
      v.onseeked = () => {
        try {
          ctx.drawImage(v, 0, 0, canvas.width, canvas.height);
          out.push(canvas.toDataURL('image/jpeg', 0.7));
        } catch (e) {}
        i++;
        if (i < times.length) v.currentTime = times[i];
        else { URL.revokeObjectURL(url); resolve(out); }
      };
      v.currentTime = times[0];
    };
  });
}

// ----- generation -----
async function generate() {
  const btn = document.getElementById('genBtn');
  const stat = document.getElementById('genStat');
  btn.disabled = true; stat.textContent = 'Watching your video...'; stat.className = 'stat';
  try {
    const r = await fetch('/api/generate', {method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({frames, filename: videoFile ? videoFile.name : ''})});
    const d = await r.json();
    if (r.status === 402) { document.getElementById('paywall').classList.remove('hidden'); stat.textContent=''; return; }
    if (!d.ok) throw new Error(d.error || 'failed');
    lastGen = d;
    document.getElementById('fTitle').value = d.title || '';
    document.getElementById('fDesc').value = d.description || '';
    document.getElementById('fTags').value = (d.hashtags || []).join(' ');
    document.getElementById('fTiktok').value = d.tiktok || '';
    document.getElementById('fInsta').value = d.instagram || '';
    document.getElementById('fTweet').value = d.tweet || '';
    document.getElementById('result').classList.remove('hidden');
    stat.textContent = 'Done';
    stat.className = 'stat ok';
  } catch (e) {
    stat.textContent = 'Generation failed, try again.';
    stat.className = 'stat err';
  }
  btn.disabled = false;
}

// ----- YouTube upload, straight from the browser -----
async function uploadToYouTube() {
  if (!videoFile) return;
  const stat = document.getElementById('upStat');
  const btn = document.getElementById('upBtn');
  btn.disabled = true; stat.textContent = 'Getting permission...'; stat.className = 'stat';
  try {
    const tr = await fetch('/api/youtube-token', {method:'POST'});
    const td = await tr.json();
    if (tr.status === 402) { document.getElementById('paywall').classList.remove('hidden'); throw new Error('trial'); }
    if (!td.ok) { stat.textContent = 'YouTube needs reconnecting. Sign out and back in.'; stat.className='stat err'; btn.disabled=false; return; }
    const token = td.accessToken;

    const tags = document.getElementById('fTags').value.trim().split(/\s+/).filter(Boolean).slice(0, 30);
    const meta = {
      snippet: {
        title: document.getElementById('fTitle').value.slice(0, 100),
        description: document.getElementById('fDesc').value +
          (tags.length ? '\n\n' + tags.map(t => '#' + t).join(' ') : ''),
        tags: tags,
        categoryId: '24'
      },
      status: { privacyStatus: 'public', selfDeclaredMadeForKids: false }
    };

    stat.textContent = 'Starting upload...';
    const start = await fetch('https://www.googleapis.com/upload/youtube/v3/videos?uploadType=resumable&part=snippet,status', {
      method: 'POST',
      headers: {
        'Authorization': 'Bearer ' + token,
        'Content-Type': 'application/json',
        'X-Upload-Content-Type': videoFile.type || 'video/mp4',
        'X-Upload-Content-Length': String(videoFile.size)
      },
      body: JSON.stringify(meta)
    });
    if (!start.ok) throw new Error('start ' + start.status);
    const sessionUrl = start.headers.get('Location');
    if (!sessionUrl) throw new Error('no session');

    document.getElementById('upBarWrap').classList.remove('hidden');
    await new Promise((resolve, reject) => {
      const xhr = new XMLHttpRequest();
      xhr.open('PUT', sessionUrl);
      xhr.setRequestHeader('Content-Type', videoFile.type || 'video/mp4');
      xhr.upload.onprogress = e => {
        if (e.lengthComputable)
          document.getElementById('upBar').style.width = Math.round(e.loaded / e.total * 100) + '%';
      };
      xhr.onload = () => (xhr.status >= 200 && xhr.status < 300) ? resolve() : reject(new Error('put ' + xhr.status));
      xhr.onerror = () => reject(new Error('network'));
      xhr.send(videoFile);
    });

    stat.textContent = 'Uploaded to YouTube';
    stat.className = 'stat ok';
    document.getElementById('crosspost').classList.remove('hidden');
  } catch (e) {
    if (String(e.message) !== 'trial') { stat.textContent = 'Upload failed: ' + e.message; stat.className = 'stat err'; }
  }
  btn.disabled = false;
}

// ----- cross-posting -----
async function crossPost(where) {
  if (where === 'x') {
    const text = document.getElementById('fTweet').value;
    window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(text), '_blank');
    return;
  }
  const text = where === 'tiktok'
    ? document.getElementById('fTiktok').value
    : document.getElementById('fInsta').value;
  try { await navigator.clipboard.writeText(text); } catch (e) {}
  window.open(where === 'tiktok' ? 'https://www.tiktok.com/upload' : 'https://www.instagram.com/', '_blank');
}

boot();
</script>
</body>
</html>
